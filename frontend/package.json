{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:studio": "playwright test e2e/studio-routes.spec.ts",
    "test:e2e:labs": "playwright test e2e/research.spec.ts --workers=1",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsrs --noEmit --fast -p .",
    "typecheck:ref": "tsc --noEmit -p .",
    "knip": "knip --no-progress",
    "dup": "jscpd src",
    "size": "size-limit",
    "compiler:check": "react-compiler-healthcheck --src \"src/**/*.tsx\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/d3": "^7.4.3",
    "@types/react-grid-layout": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.23.26",
    "geist": "^1.7.2",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.555.0",
    "next": "~16.4.5",
    "nextjs-toploader": "^3.9.17",
    "plotly.js": "^3.6.0",
    "plotly.js-dist-min": "^3.3.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-grid-layout": "^2.2.2",
    "react-hot-toast": "^2.6.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^4.14.2",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@size-limit/file": "14.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "25.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jscpd": "5.4.2",
    "jsdom": "^31.0.0",
    "knip": "6.44.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "^1.60.0",
    "react-compiler-healthcheck": "1.0.0",
    "size-limit": "14.3.0",
    "tailwindcss": "^4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "size-limit": [
    {
      "path": ".next/static/chunks/**/*.js",
      "limit": "6 MB"
    }
  ]
}

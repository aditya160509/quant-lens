    {
      "name": "backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd '/Users/adityabalaji/Downloads/quant  2/backend' && OMP_NUM_THREADS=1 .venv/bin/python -m uvicorn main:app --port 8000"

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd '/Users/adityabalaji/Downloads/quant  2/frontend' && npm run dev -- --port 3000"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd '/Users/adityabalaji/Downloads/quant  2/frontend' && npm run build && npm run start -- --port 3000"
      ],
      "port": 3000

# =============================================================================
# Quant360 Elite - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive secrets!
# =============================================================================

# =============================================================================
# API KEYS FOR DATA PROVIDERS
# =============================================================================
# FRED (Federal Reserve Economic Data) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# BLS (Bureau of Labor Statistics) - https://www.bls.gov/developers/
BLS_API_KEY=your_bls_api_key_here

# EIA (Energy Information Administration) - https://www.eia.gov/opendata/
EIA_API_KEY=your_eia_api_key_here

# USDA QuickStats - https://quickstats.nass.usda.gov/api
QUICKSTATS_API_KEY=your_quickstats_api_key_here

# BEA (Bureau of Economic Analysis) - https://apps.bea.gov/API/signup/
BEA_API_KEY=your_bea_api_key_here

# =============================================================================
# SUPABASE (Database & Auth)
# =============================================================================
# Get these from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

# Public (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Private (backend only - NEVER expose in frontend!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================
# Razorpay (for INR payments) - https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Stripe (for USD/international) - https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# =============================================================================
# APPLICATION URLS
# =============================================================================
# Frontend URL (for CORS, payment redirects, etc.)
FRONTEND_URL=http://localhost:3000

# Backend API URL (for frontend to call)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# =============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# =============================================================================
# Polygon.io (real-time market data)
# POLYGON_API_KEY=your_key_here

# OpenAI (for AI features)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to 'development' or 'production'
NODE_ENV=development

# Enable debug logging
DEBUG=false
